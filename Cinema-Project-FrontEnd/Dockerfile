# build build folder 
FROM node:20-alpine AS builder

WORKDIR /project_movie

COPY package.json yarn.lock* ./

RUN yarn config set network-timeout 3000000

RUN yarn install

COPY . .

ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

ARG REACT_APP_AUTHORIZATION_TOKEN
ENV REACT_APP_AUTHORIZATION_TOKEN=$REACT_APP_AUTHORIZATION_TOKEN

ARG REACT_APP_TOKEN_BACKEND
ENV REACT_APP_TOKEN_BACKEND=$REACT_APP_TOKEN_BACKEND

ARG REACT_APP_THE_MOVIEDB_AUTHORIZATION_TOKEN
ENV REACT_APP_THE_MOVIEDB_AUTHORIZATION_TOKEN=$REACT_APP_THE_MOVIEDB_AUTHORIZATION_TOKEN

RUN yarn build

# build image 
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

COPY --from=builder /project_movie/build .

EXPOSE 80